rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'p82fI4PrieTw7SdFe2PX8A3xmnG3';
    }

    match /monitoring/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /chunks/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /receiving/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /receiving_chunks/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /activity_logs/{activityId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'action', 'details', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'action', 'details', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.action is string
        && (request.resource.data.action in ['data_upload_started', 'data_upload_completed']
          ? isAdmin()
          : true)
        && request.resource.data.action in [
          'login',
          'signup',
          'logout',
          'activity_view',
          'activity_refresh',
          'activity_page',
          'feed_access',
          'feed_view',
          'feed_loaded',
          'data_upload_started',
          'data_upload_completed',
          'search',
          'filter_change',
          'show_more',
          'export'
        ]
        && request.resource.data.action.size() <= 128
        && request.resource.data.details is map
        && request.resource.data.details.keys().size() <= 8
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
